# ══════════════════════════════════════════════════════════════════════════════
# SMARTBUS Backend Environment Configuration Example
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and adjust SERIAL_PORT to match your system.
#
# On Windows: Check Device Manager -> Ports (COM & LPT) (e.g., COM3, COM4, COM5)
# On macOS:   Check /dev/cu.usbserial-* or /dev/tty.SLAB_USBtoUART
# On Linux:   Check /dev/ttyUSB0 or /dev/ttyACM0

PORT=8080
HOST=0.0.0.0
SERIAL_PORT=COM5
BAUD_RATE=115200
DEVICE_TIMEOUT_MS=10000
SERIAL_RECONNECT_INTERVAL_MS=3000
